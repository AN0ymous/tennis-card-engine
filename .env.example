# Copy this file to .env (same folder as server.py) and fill in the values.
# .env is gitignored, so your keys never leave this machine.

# Required. Free at https://developer.ebay.com/my/keys -- use the PRODUCTION
# keyset, not the sandbox one.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional. Set to "sandbox" to test a Sandbox keyset (App ID contains "SBX")
# against eBay's sandbox, which has no real listings. Leave blank for real
# scans with a Production keyset.
EBAY_ENV=

# Optional: email a digest of new matches after each scheduled run.
# DIGEST_FROM_APP_PASSWORD is a Gmail "app password", not your account
# password: https://myaccount.google.com/apppasswords
DIGEST_FROM_EMAIL=
DIGEST_FROM_APP_PASSWORD=
# Where to send it. Defaults to DIGEST_FROM_EMAIL when left blank.
DIGEST_TO_EMAIL=

# Optional: lets the engine read the colour of the player's outfit from the
# listing photo, for the colour-match filter (outfit colour = parallel colour).
# One short call per recorded card that names a colour parallel, answers
# cached so no photo is asked about twice. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# VISION_MODEL=claude-opus-5
